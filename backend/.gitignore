bin/
obj/
*.user

# Documentos subidos/generados en tiempo de ejecución (no versionar contenido real)
ChatbotDocs.Api/Storage/Uploads/*
!ChatbotDocs.Api/Storage/Uploads/.gitkeep
ChatbotDocs.Api/Storage/Generated/*
!ChatbotDocs.Api/Storage/Generated/.gitkeep

# Documentos fuente reales (marco legal, formularios, etc.) colocados manualmente:
# no se versionan, cada entorno pone los suyos.
ChatbotDocs.Api/Documentos/*
!ChatbotDocs.Api/Documentos/.gitkeep

# Secretos locales
appsettings.Local.json
.env
